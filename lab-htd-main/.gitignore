# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Project outputs
# ---------------------------------------------------------------------------
# Training checkpoints / loss curves and evaluation outputs are local artifacts.
# Keep any already-tracked sample weights, but do not add newly generated runs.
models/**
results/**
logs/**

# Large local datasets are not source code. Already-tracked sample datasets stay
# tracked by git, while newly added .mat files remain local.
*.mat
*.zip

# Figures are generated artifacts except for checked-in documentation assets.
*.png
!assets/*.png
