# ---------------------------------------------------------------------------
# Build artifacts (CUDA / C++ extensions: selective_scan_cuda, causal_conv1d)
# These are only produced on Linux + CUDA via `pip install .` and must never be
# committed. On Windows they are not built at all (pure-PyTorch fallback is used).
# ---------------------------------------------------------------------------
build/
dist/
*.o
*.obj
*.dll
*.dylib
*.pyd
selective_scan_cuda*
mamba_ssm.egg-info/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.conda/

